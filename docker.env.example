# Plantilla de red HTTPS. Para arrancar solo en este PC use el archivo local de la entrega.
# Modo local: MATRICULA_DOCKER_MODE=local y MATRICULA_LOCAL_PORT=4319 (127.0.0.1 fijo).
MATRICULA_DOCKER_MODE=tls
MATRICULA_PUBLIC_ORIGIN=https://matricula.colegio.invalid:4433
MATRICULA_TLS_PORT=4433
MATRICULA_TLS_BIND=0.0.0.0
MATRICULA_TLS_CERT_FILE=./certificados/matricula.crt
MATRICULA_TLS_KEY_FILE=./certificados/matricula.key
# Alternative proxy mode uses the existing school's HTTPS reverse proxy:
MATRICULA_HTTP_PORT=4319
MATRICULA_IMAGE=puramatricula:0.2.0
MATRICULA_DATA_VOLUME=puramatricula_data
MATRICULA_NETWORK_NAME=puramatricula_private
# Only if the existing TLS proxy runs in another container:
# MATRICULA_PROXY_NETWORK=nombre_explicito_de_la_red_del_proxy
