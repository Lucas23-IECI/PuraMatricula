# Deny by default: the build context never contains operational configuration/data.
**
!Dockerfile
!package.json
!package-lock.json
!src/
!src/**/*.mjs
!src/*.mjs
!public/
!public/**/*.js
!public/**/*.css
!public/**/*.html
!public/**/*.jpg
!public/**/*.jpeg
!public/**/*.png
!public/**/*.svg
!public/**/*.ico
!public/**/*.webp
!public/**/*.woff
!public/**/*.woff2
!public/*.js
!public/*.css
!public/*.html
!public/*.jpg
!public/*.jpeg
!public/*.png
!public/*.svg
!public/*.ico
!public/*.webp
!public/*.woff
!public/*.woff2
!scripts/
!scripts/docker-*.mjs
!scripts/school-start.mjs
# These remain excluded even if a future source rule becomes broader.
**/.env*
**/*.env
**/*.sqlite*
**/*.db
**/*.key
**/*.pem
**/*.dsmbak
**/node_modules/**
**/.local/**
**/backups/**
**/output/**
