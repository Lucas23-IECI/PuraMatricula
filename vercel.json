{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {"api/index.mjs": {"maxDuration": 300, "includeFiles": "src/**"}},
  "rewrites": [{"source": "/api/:path*", "destination": "/api/index"}],
  "headers": [{"source": "/(.*)", "headers": [
    {"key":"X-Content-Type-Options","value":"nosniff"},
    {"key":"Referrer-Policy","value":"no-referrer"},
    {"key":"X-Frame-Options","value":"DENY"},
    {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'none'"},
    {"key":"Cache-Control","value":"no-store"}
  ]}]
}
